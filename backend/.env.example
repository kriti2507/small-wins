# Local development environment for the Flask backend.
# Copy to backend/.env and fill in. backend/.env is gitignored.
# Use a separate dev Supabase project here, never production's keys
# (see "Local development" in DEPLOYMENT.md).

# --- Database (dev Supabase project) ---------------------------------------
# Use the SESSION pooler string (port 5432) locally. Vercel uses the
# TRANSACTION pooler (6543) instead.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Image storage (same dev project) --------------------------------------
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your-dev-secret-key
SUPABASE_BUCKET=uploads

# --- Google sign-in ---------------------------------------------------------
# Same OAuth client as production. Its authorized redirect URIs must include
# http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=123456789012-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# Comma-separated Google emails allowed to sign in.
ALLOWED_EMAILS=you@gmail.com

# Signs the login cookie. Generate a NEW one for dev (not production's):
#   .venv/bin/python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
