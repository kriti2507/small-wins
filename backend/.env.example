# Local development environment for the Flask backend.
# Copy to backend/.env and fill in. backend/.env is gitignored.

# Supabase Postgres. For LOCAL dev use the SESSION pooler (port 5432) or a
# direct connection; PRODUCTION (Vercel) uses the TRANSACTION pooler (6543).
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Supabase Storage (image uploads)
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=uploads

# Leave ADMIN_PASSWORD_HASH and SECRET_KEY unset locally to stay in
# dev-admin mode (every request is admin, no login needed).
